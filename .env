# ==============================================================
# KONFIGURASI SERVER ENDPOINT GAWE FLUTTER
# ==============================================================
# 
# PANDUAN PENGGUNAAN:
# 
# 1. JIKA PEMBELI MEMBELI FULL SOURCE CODE FLUTTER:
#    - Isi BASE_URL dengan domain/IP server backend Laravel presensigpsv2 kantor/klien.
#    - Ubah REQUIRE_SERVER_CONFIG=false
#    - Build APK. Hasil APK ini TIDAK AKAN meminta karyawan/user mengisi URL server.
#    Contoh:
#    BASE_URL=http://192.168.1.117:8000
#    REQUIRE_SERVER_CONFIG=false
#
# 2. JIKA ANDA MERILIS / MENJUAL FILE APK SAJA (Tanpa Source Code Flutter):
#    - Kosongkan BASE_URL (atau biarkan default)
#    - Ubah REQUIRE_SERVER_CONFIG=true
#    - Build APK. Ketika pembeli/user pertama kali menginstall & membuka aplikasi,
#      aplikasi akan otomatis mengarahkan ke halaman Setup Endpoint Server.
#    - Pengguna memasukkan URL server mereka sekali saja, dan tersimpan aman di HP.
# ==============================================================

# URL Server Backend (Kosongkan jika ingin user input manual saat pertama kali buka aplikasi)
BASE_URL=

# Wajibkan konfigurasi server manual oleh pengguna jika belum diisi? (true / false)
REQUIRE_SERVER_CONFIG=true
